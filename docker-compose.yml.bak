name: node-trigger
services:
    node-trigger:
        build:
            context: /DATA/AppData/node-trigger
            dockerfile: Dockerfile
        cpu_shares: 90
        command: []
        container_name: node-trigger
        deploy:
            resources:
                limits:
                    memory: "10315890688"
        environment:
            PORT: "3000"
            STATE: ENABLE
        hostname: node-trigger
        image: node-trigger:latest
        networks:
            default: null
        ports:
            - mode: ingress
              target: 3000
              published: "8687"
              protocol: tcp
        restart: unless-stopped
networks:
    default:
        name: node-trigger_default
x-casaos:
    author: self
    category: self
    hostname: ""
    icon: ""
    index: /
    is_uncontrolled: false
    port_map: ""
    scheme: http
    title:
        custom: Node Trigger
